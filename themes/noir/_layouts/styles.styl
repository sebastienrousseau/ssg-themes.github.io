// Compiled from the local Skeletonic Stylus 2.x source requested for this
// collection. The generated styles.css is committed so the theme ships ready
// to use; this source records the exact foundation used to create it.
@import "skeletonic-stylus/src/stylus/skeletonic.styl"

@css {
@layer theme.tokens, theme.base, theme.layout, theme.components, theme.variants;

@layer theme.tokens {
:root,
:root[data-theme="light"] {
  --bg: #f5f4ef;
  --bg-soft: #e9e9e9;
  --surface: #ffffff;
  --surface-soft: #f0f0f0;
  --ink: #101713;
  --ink-soft: #2e4037;
  --ink-muted: #3f4642;
  --accent: #202020;
  --accent-hover: #050505;
  --accent-ink: #ffffff;
  --accent-soft: #e5e5e5;
  --on-accent-soft: #242424;
  --focus: #994100;
  --line: #707a74;
  --line-soft: #c9cec9;
  --scene: #090a0b;
  --scene-ink: #ffffff;
  --scene-muted: #d9eee6;
  --scene-accent: #ffffff;
  --glow: #bfc3c8;
  --shadow: 0 1.5rem 4rem rgb(12 31 23 / 14%);
  --background-color: var(--bg);
  --foreground-color: var(--ink);
  --focus-ring-color: var(--focus);
  color-scheme: light;
}

:root[data-theme="dark"] {
  --bg: #0d1210;
  --bg-soft: #121212;
  --surface: #1b1b1b;
  --surface-soft: #252525;
  --ink: #f5faf7;
  --ink-soft: #d4e3da;
  --ink-muted: #b9cec1;
  --accent: #ffffff;
  --accent-hover: #ffffff;
  --accent-ink: #111111;
  --accent-soft: #3b3b3b;
  --on-accent-soft: #ffffff;
  --focus: #ffb27b;
  --line: #82968a;
  --line-soft: #3e5147;
  --scene: #070707;
  --scene-ink: #ffffff;
  --scene-muted: #d9eee6;
  --scene-accent: #ffffff;
  --glow: #4b4b4b;
  --shadow: 0 1.5rem 4rem rgb(0 0 0 / 44%);
  --background-color: var(--bg);
  --foreground-color: var(--ink);
  --focus-ring-color: var(--focus);
  color-scheme: dark;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0d1210;
    --bg-soft: #121212;
    --surface: #1b1b1b;
    --surface-soft: #252525;
    --ink: #f5faf7;
    --ink-soft: #d4e3da;
    --ink-muted: #b9cec1;
    --accent: #ffffff;
    --accent-hover: #ffffff;
    --accent-ink: #111111;
    --accent-soft: #3b3b3b;
    --on-accent-soft: #ffffff;
    --focus: #ffb27b;
    --line: #82968a;
    --line-soft: #3e5147;
    --scene: #070707;
    --scene-ink: #ffffff;
    --scene-muted: #d9eee6;
    --scene-accent: #ffffff;
    --glow: #4b4b4b;
    --background-color: var(--bg);
    --foreground-color: var(--ink);
    --focus-ring-color: var(--focus);
    color-scheme: dark;
  }
}

:root {
  --step--1: clamp(0.82rem, 0.79rem + 0.15vw, 0.92rem);
  --step-0: clamp(1rem, 0.96rem + 0.22vw, 1.14rem);
  --step-1: clamp(1.24rem, 1.12rem + 0.58vw, 1.62rem);
  --step-2: clamp(1.62rem, 1.35rem + 1.3vw, 2.5rem);
  --step-3: clamp(2.15rem, 1.65rem + 2.5vw, 3.85rem);
  --step-4: clamp(2.8rem, 1.85rem + 4.8vw, 6rem);
  --space: clamp(1rem, 0.72rem + 1.4vw, 2rem);
  --section: clamp(4rem, 2.7rem + 6vw, 8rem);
  --radius: 1rem;
  --radius-lg: 1.8rem;
  --measure: 67ch;
  --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-serif: Iowan Old Style, Baskerville, "Times New Roman", serif;
}
}

@layer theme.rebuild {
html { overflow-x:clip; }
.style-noir { --black:var(--scene); --panel:var(--surface); --white:var(--scene-ink); --grey:var(--ink-muted); background:var(--bg); color:var(--ink); }
.style-noir .wrap { width:min(calc(100% - 3rem),92rem); margin-inline:auto; }
.style-noir h1,.style-noir h2,.style-noir h3 { color:inherit; font-family:Arial,Helvetica,sans-serif; }
.style-noir .site-header { position:absolute; inset:5rem 5% auto; z-index:20; width:90%; border:0; background:#111; backdrop-filter:none; }
.style-noir .nav-toggle { color:#fff; }
.style-noir .brand,.style-noir .site-nav a,.style-noir .mode-toggle { color:var(--ink); }
body.style-noir:has(.noir-showcase) .brand,
body.style-noir:has(.noir-showcase) .site-nav a,
body.style-noir:has(.noir-showcase) .mode-toggle { color:var(--scene-ink); }
.style-noir .brand-mark { border-radius:.2rem; background:#fff; color:#111; }
.style-noir .site-nav .nav-cta { background:transparent; }
.style-noir .mode-toggle { border-color:#888; }
.noir-showcase { position:relative; min-height:calc(100svh - 8rem); margin:4rem; overflow:hidden; background:var(--black); color:#fff; }
.noir-tools { position:absolute; left:3%; top:17%; z-index:3; display:flex; gap:2rem; align-items:center; }
.noir-tools a { display:inline-flex; min-height:3rem; align-items:center; color:#fff; font-weight:700; }
.product-frame { position:absolute; left:3%; top:25%; bottom:6%; width:34%; overflow:clip; border-radius:1rem; background:#e7ecee; }.product-frame::after{content:"";position:absolute;inset:1.5rem -1rem -1rem 1.5rem;border:1px solid #555;border-radius:1rem;z-index:-1}.product-frame picture,.product-frame img{display:block;width:100%;height:100%}.product-frame img{object-fit:cover;object-position:center top}
.product-copy { position:absolute; z-index:6; left:48%; top:27%; width:24%; }.product-copy>p{font-size:1.2rem}.swatches{display:flex;align-items:center;gap:.8rem;margin-top:1.2rem}.swatches span{display:grid;place-items:center;width:3rem;aspect-ratio:1;border:1px solid #666;border-radius:50%;font-size:.65rem}.swatches .active{background:#fff;color:#111}.swatches a{display:grid;place-items:center;width:2.7rem;aspect-ratio:1;border-radius:50%;background:#fff;color:#111;text-decoration:none}
.noir-benefits { position:absolute; top:27%; right:3%; width:23%; margin:0; padding:0; list-style:none; }.noir-benefits li{display:flex;justify-content:space-between;padding:1rem 0;border-block-start:1px dashed #777;color:#ddd}.noir-benefits b{color:#fff}
.noir-statement { position:absolute; left:48%; right:3%; bottom:5%; }.noir-statement>span{display:inline-block;padding:.6rem 1rem;border:1px solid #777;border-radius:3rem}.noir-statement h1{max-width:none;margin-top:1.5rem;font-size:clamp(2.3rem,4vw,4.8rem);font-weight:400;line-height:1.04}.noir-statement h1 em{color:#777;font-style:normal}.noir-statement h1 b{display:inline-grid;place-items:center;width:2.4rem;aspect-ratio:1;border-radius:50%;background:#fff;color:#111;font-size:1rem;vertical-align:middle}
.noir-drop { padding:9rem 0; background:var(--bg-soft); }.noir-drop header{display:flex;justify-content:space-between;align-items:end;margin-bottom:4rem}.noir-drop h2{font-size:clamp(3.5rem,7vw,7rem);text-transform:uppercase}.drop-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.drop-grid article{padding:1rem;border:1px solid var(--line)}.product-silhouette{position:relative;height:25rem;margin-bottom:1.5rem;background:var(--surface-soft)}.product-silhouette::before{content:"";position:absolute;inset:12% 25% 5%;border-radius:30% 30% 8% 8%;background:var(--scene)}.product-silhouette::after{content:"";position:absolute;left:17%;right:17%;top:25%;height:40%;border-radius:50%;background:var(--scene)}.product-silhouette.long::before{inset:8% 29% 2%}.product-silhouette.vest::after{display:none}.drop-grid h3{margin:.5rem 0;font-size:1.7rem}.drop-grid p{color:var(--ink-soft)}.drop-grid strong{display:block;margin-top:1rem}
.noir-manifesto { padding:10rem 0; background:#111; color:#fff; }.noir-manifesto .wrap{display:grid;grid-template-columns:.3fr 1.1fr .6fr;gap:4rem}.noir-manifesto h2{font-size:clamp(4rem,8vw,8rem);text-transform:uppercase;line-height:.86}.noir-manifesto p{color:#ddd}.noir-manifesto a{display:inline-flex;margin-top:2rem;color:#fff;font-weight:800}
.noir-close { padding:10rem 4vw; background:var(--surface); color:var(--ink); text-align:center; }.noir-close h2{margin:.7rem 0 2rem;font-size:clamp(4rem,9vw,9rem);text-transform:uppercase}.noir-close a{display:inline-flex;padding:1rem 1.5rem;background:var(--scene);color:var(--scene-ink);text-decoration:none;font-weight:900}
.style-noir .site-footer{background:#111;color:#fff;border-color:#444}.style-noir .site-footer a,.style-noir .site-footer p,.style-noir .site-footer h2{color:#fff}
@media(max-width:64rem){.style-noir .site-header{position:relative;inset:auto;width:auto;background:#111}.noir-showcase{margin:0;min-height:75rem}.product-frame{top:17%;width:55%;height:35rem;bottom:auto}.product-copy{left:62%;top:22%;width:33%}.noir-benefits{left:62%;right:3%;top:44%;width:auto}.noir-statement{left:3%;bottom:4%}.drop-grid{grid-template-columns:1fr}.noir-manifesto .wrap{grid-template-columns:1fr}}
@media(max-width:42rem){.noir-tools{top:3%;left:1rem}.noir-tools a:last-child{display:none}.product-frame{left:1rem;right:1rem;top:10%;width:auto;height:34rem}.product-copy,.noir-benefits{display:none}.noir-statement{left:1rem;right:1rem}.noir-showcase{min-height:63rem}.noir-statement h1{font-size:2.5rem}.noir-drop header{align-items:flex-start;flex-direction:column}.noir-drop h2,.noir-manifesto h2{font-size:clamp(2.5rem,13vw,4rem)}.noir-manifesto .wrap>*{min-width:0}.style-noir .wrap{width:min(calc(100% - 2rem),92rem)}}
.swatches span{font-size:.75rem}
body:not(:has(.noir-showcase)) .site-header{background:var(--bg)}
body:not(:has(.noir-showcase)) .site-header .brand,body:not(:has(.noir-showcase)) .site-header .site-nav a,body:not(:has(.noir-showcase)) .site-header .mode-toggle{color:var(--ink)}
body:not(:has(.noir-showcase)) .eyebrow{color:var(--accent)}
body:not(:has(.noir-showcase)) .lead{color:var(--ink-soft)}
.style-noir .skip-link{background:#000;color:#fff}
.noir-statement h1 em{color:#fff}
.swatches a{width:2.75rem}
.swatches a{background:#fff!important;color:#000!important}
.noir-benefits b{background:#101010;color:#fff}
body:not(:has(.noir-showcase)) .eyebrow{background:var(--bg)}
}

@layer theme.base {
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body { margin: 0; overflow-x: clip; background: var(--bg); color: var(--ink); font-family: var(--font-sans); font-size: var(--step-0); line-height: 1.62; }
h1, h2, h3, p, ul, dl, dd, figure, blockquote { margin: 0; }
h1, h2, h3 { color: var(--ink); font-weight: 760; line-height: 1.02; letter-spacing: -0.045em; text-wrap: balance; word-break: normal; overflow-wrap: normal; hyphens: none; }
h1 { font-size: var(--step-4); max-width: 12ch; }
h2 { font-size: var(--step-3); max-width: 17ch; }
h3 { font-size: var(--step-1); letter-spacing: -0.025em; }
p { max-width: var(--measure); text-wrap: pretty; }
a { color: var(--accent); text-decoration-thickness: 0.09em; text-underline-offset: 0.2em; }
a:hover { color: var(--accent-hover); }
img, svg { display: block; max-width: 100%; }
button { font: inherit; }
:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; border-radius: 0.25rem; }
::selection { background: var(--accent); color: var(--accent-ink); }
}

@layer theme.layout {
.container { width: min(100% - 2rem, 88rem); margin-inline: auto; padding-inline: 0; }
.section { padding-block: var(--section); }
.section-head { display: grid; gap: 1rem; max-width: 52rem; margin-block-end: clamp(2.5rem, 5vw, 5rem); }
.split-head { max-width: none; grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.65fr); align-items: end; }
.lead { color: var(--ink-soft); font-size: var(--step-1); line-height: 1.48; }
.eyebrow { color: var(--accent); font-size: var(--step--1); font-weight: 800; letter-spacing: 0.13em; text-transform: uppercase; }
.hero { position: relative; padding-block: clamp(3rem, 7vw, 8rem); border-block-end: 1px solid var(--line-soft); }
.hero-grid { display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(22rem, 1.08fr); align-items: center; gap: clamp(2rem, 6vw, 7rem); min-height: min(49rem, calc(100svh - 5rem)); }
.hero-copy { position: relative; z-index: 2; display: grid; gap: 1.35rem; }
.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; padding-block-start: 0.55rem; }
.hero-art { position: relative; isolation: isolate; min-height: clamp(24rem, 45vw, 39rem); border: 1px solid var(--line-soft); border-radius: var(--radius-lg); background: var(--surface-soft); box-shadow: var(--shadow); overflow: clip; }
.proof { border-block-end: 1px solid var(--line-soft); background: var(--surface); }
.metric-grid { display: grid; grid-template-columns: repeat(3, minmax(9rem, 0.7fr)) minmax(16rem, 1.3fr); }
.metric-grid > * { padding: 2rem; border-inline-start: 1px solid var(--line-soft); }
.metric-grid > :last-child { border-inline-end: 1px solid var(--line-soft); }
.metric-grid dl { display: flex; flex-direction: column-reverse; gap: 0.4rem; }
.metric-grid dt { color: var(--ink-muted); font-size: var(--step--1); }
.metric-grid dd { font-size: var(--step-2); font-weight: 780; letter-spacing: -0.04em; }
.proof-note { align-self: center; color: var(--ink-soft); font-size: var(--step--1); }
.service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--line); }
.service-card { display: grid; align-content: start; gap: 1.15rem; min-height: 23rem; padding: clamp(1.5rem, 3.5vw, 3rem); border-inline-end: 1px solid var(--line); }
.service-card:last-child { border-inline-end: 0; }
.service-card .index { color: var(--ink-muted); font: 700 var(--step--1)/1 var(--font-sans); }
.service-card p { color: var(--ink-soft); }
.service-card a { display: inline-flex; align-items: center; min-height: 2.75rem; margin-block-start: auto; width: fit-content; font-weight: 750; }
.feature-section { background: var(--bg-soft); }
.feature-grid { display: grid; grid-template-columns: minmax(20rem, 1fr) minmax(0, 0.82fr); align-items: center; gap: clamp(2.5rem, 7vw, 8rem); }
.feature-copy { display: grid; gap: 1.25rem; }
.feature-art { position: relative; min-height: clamp(26rem, 45vw, 43rem); overflow: clip; border-radius: var(--radius-lg); background: var(--scene); color: var(--scene-ink); }
.feature-caption { position: absolute; inset: auto 1.5rem 1.5rem; z-index: 2; max-width: 20ch; padding: 0.65rem 0.85rem; background: var(--scene-ink); color: var(--scene); font-size: var(--step--1); font-weight: 750; }
.check-list { display: grid; gap: 0.8rem; padding: 0; list-style: none; }
.check-list li { position: relative; padding-inline-start: 1.75rem; }
.check-list li::before { content: "✓"; position: absolute; inset-inline-start: 0; color: var(--accent); font-weight: 900; }
.text-link { width: fit-content; min-height: 2.75rem; display: inline-flex; align-items: center; font-weight: 800; }
.work-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space); }
.work-card { display: grid; gap: 0.85rem; min-width: 0; }
.work-card:nth-child(1) { grid-column: span 5; }
.work-card:nth-child(2) { grid-column: span 7; }
.work-card:nth-child(3) { grid-column: 4 / span 6; margin-block-start: var(--space); }
.work-card > p:not(.tag) { color: var(--ink-soft); }
.work-visual { position: relative; min-height: clamp(18rem, 31vw, 31rem); margin-block-end: 0.5rem; overflow: clip; border: 1px solid var(--line-soft); border-radius: var(--radius); background: var(--surface-soft); }
.tag { width: fit-content; color: var(--on-accent-soft); background: var(--accent-soft); padding: 0.25rem 0.55rem; font-size: var(--step--1); font-weight: 800; }
.quote-section { background: var(--surface); border-block: 1px solid var(--line-soft); }
.quote-grid { display: grid; grid-template-columns: 0.35fr 1fr; gap: var(--space); }
blockquote p { max-width: 31ch; font: 600 var(--step-2)/1.25 var(--font-serif); }
figcaption { margin-block-start: 1.5rem; color: var(--ink-muted); }
.closing { background: var(--scene); color: var(--scene-ink); }
.closing h2, .closing .eyebrow { color: var(--scene-ink); }
.closing-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
.page-grid { display: grid; grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1fr); gap: clamp(3rem, 8vw, 9rem); align-items: start; }
.page-grid > * { min-width: 0; }
.page-grid header { position: sticky; top: 7rem; display: grid; gap: 1rem; }
.prose { max-width: 68ch; }
.prose > * + * { margin-block-start: 1.6lh; }
.prose h2 { margin-block-start: 1.8em; }
.prose ul, .prose ol { padding-inline-start: 1.35rem; }
.error-page { min-height: 70svh; display: grid; align-items: center; }
.error-page .container { display: grid; gap: 1.5rem; }
}

@layer theme.components {
.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
.skip-link { position: fixed; inset: 0 auto auto 1rem; z-index: 100; translate: 0 -150%; padding: 0.75rem 1rem; background: var(--surface); color: var(--ink); border: 3px solid var(--focus); }
.skip-link:focus { translate: 0 1rem; }
.site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 94%, transparent); border-block-end: 1px solid var(--line-soft); backdrop-filter: blur(18px); }
.header-inner { display: flex; align-items: center; min-height: 5rem; gap: 1rem; }
.brand { display: inline-flex; align-items: center; gap: 0.65rem; min-height: 2.75rem; color: var(--ink); font-size: 1.12rem; font-weight: 850; letter-spacing: -0.025em; text-decoration: none; }
.brand:hover { color: var(--ink); }
.brand-mark { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-size: 0.85rem; }
.site-nav { display: flex; align-items: center; gap: 0.2rem; margin-inline-start: auto; }
.site-nav a, .mode-toggle, .nav-toggle { display: inline-flex; align-items: center; justify-content: center; min-width: 2.75rem; min-height: 2.75rem; padding-inline: 0.75rem; border: 0; background: transparent; color: var(--ink-soft); font-size: var(--step--1); font-weight: 740; text-decoration: none; cursor: pointer; }
.site-nav a:hover, .mode-toggle:hover, .nav-toggle:hover { color: var(--ink); background: var(--surface-soft); }
.site-nav .nav-cta { margin-inline-start: 0.5rem; border-radius: 999px; background: var(--accent); color: var(--accent-ink); padding-inline: 1.15rem; }
.site-nav .nav-cta:hover { background: var(--accent-hover); color: var(--accent-ink); }
.mode-toggle { gap: 0.4rem; border: 1px solid var(--line); border-radius: 999px; }
.mode-toggle svg, .nav-toggle svg { width: 1.15rem; height: 1.15rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
.nav-toggle { display: none; gap: 0.5rem; border: 1px solid var(--line); border-radius: 999px; }
.button { display: inline-flex; align-items: center; justify-content: center; min-height: 2.9rem; min-width: 2.9rem; padding: 0.7rem 1.2rem; border: 2px solid var(--accent); border-radius: 999px; font-weight: 800; text-decoration: none; }
.button-primary { background: var(--accent); color: var(--accent-ink); }
.button-primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); color: var(--accent-ink); }
.button-secondary { background: var(--surface); color: var(--accent); }
.button-secondary:hover { color: var(--accent-hover); border-color: var(--accent-hover); }
.button-inverse { border-color: var(--scene-ink); background: var(--scene-ink); color: var(--scene); }
.button-inverse:hover { background: transparent; color: var(--scene-ink); }
.art-halo { position: absolute; width: min(26rem, 90%); aspect-ratio: 1; border-radius: 50%; background: var(--glow); filter: blur(1px); inset: 8% 5% auto auto; }
.art-object { position: absolute; z-index: 1; inset: 18% 12% 8% 16%; border-radius: 48% 48% 12% 12% / 34% 34% 10% 10%; background: var(--scene); transform: rotate(-5deg); box-shadow: 1.2rem 1.2rem 0 var(--scene-accent); }
.art-object span { position: absolute; width: 44%; height: 18%; inset: 14% auto auto 28%; border: 0.7rem solid var(--scene-muted); border-inline-color: transparent; border-radius: 50%; }
.art-card { position: absolute; z-index: 4; display: grid; gap: 0.25rem; padding: 1rem; border: 1px solid #6b6b6b; background: #ffffff; color: #0b0b0b; box-shadow: var(--shadow); }
.art-card small { color: #333333; }
.art-card strong { font-size: var(--step-1); }
.art-card span { color: #333333; font-size: var(--step--1); }
.art-card-a { inset: auto auto 8% 5%; max-width: 16rem; }
.art-card-b { inset: 8% 5% auto auto; }
.art-line { position: absolute; z-index: 3; width: 45%; height: 2px; inset: 48% 5% auto auto; background: var(--scene-accent); transform: rotate(-18deg); }
.feature-shape { position: absolute; display: block; }
.shape-one { width: 70%; aspect-ratio: 1; inset: 12% auto auto 15%; border: 1.2rem solid var(--scene-accent); border-radius: 50%; }
.shape-two { width: 42%; aspect-ratio: 1; inset: 32% auto auto 29%; background: var(--scene-muted); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
.work-one .work-visual::before, .work-two .work-visual::before, .work-three .work-visual::before { content: ""; position: absolute; inset: 12%; border: 0.75rem solid var(--accent); }
