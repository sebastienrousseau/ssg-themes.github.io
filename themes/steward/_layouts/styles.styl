// Compiled from the local Skeletonic Stylus 2.x source requested for this
// collection. The generated styles.css is committed so the theme ships ready
// to use; this source records the exact foundation used to create it.
@import "skeletonic-stylus/src/stylus/skeletonic.styl"

@css {
@layer theme.tokens, theme.base, theme.layout, theme.components, theme.variants;

@layer theme.tokens {
:root,
:root[data-theme="light"] {
  --bg: #f5f4ef;
  --bg-soft: #e8ebe5;
  --surface: #ffffff;
  --surface-soft: #edf0eb;
  --ink: #101713;
  --ink-soft: #2e4037;
  --ink-muted: #3f4642;
  --accent: #174b3c;
  --accent-hover: #0b3529;
  --accent-ink: #ffffff;
  --accent-soft: #d5eee3;
  --on-accent-soft: #153a2d;
  --focus: #944000;
  --line: #707a74;
  --line-soft: #c9cec9;
  --scene: #113e34;
  --scene-ink: #ffffff;
  --scene-muted: #d9eee6;
  --scene-accent: #f4c95d;
  --glow: #b9d9ca;
  --shadow: 0 1.5rem 4rem rgb(12 31 23 / 14%);
  --background-color: var(--bg);
  --foreground-color: var(--ink);
  --focus-ring-color: var(--focus);
  color-scheme: light;
}

:root[data-theme="dark"] {
  --bg: #0d1210;
  --bg-soft: #121b17;
  --surface: #171e1a;
  --surface-soft: #1c2721;
  --ink: #f5faf7;
  --ink-soft: #d4e3da;
  --ink-muted: #b9cec1;
  --accent: #8de4bb;
  --accent-hover: #b1f3d2;
  --accent-ink: #092118;
  --accent-soft: #244838;
  --on-accent-soft: #eefbf4;
  --focus: #ffb27b;
  --line: #82968a;
  --line-soft: #3e5147;
  --scene: #081b15;
  --scene-ink: #ffffff;
  --scene-muted: #d9eee6;
  --scene-accent: #ffdc7f;
  --glow: #294f3f;
  --shadow: 0 1.5rem 4rem rgb(0 0 0 / 44%);
  --background-color: var(--bg);
  --foreground-color: var(--ink);
  --focus-ring-color: var(--focus);
  color-scheme: dark;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0d1210;
    --bg-soft: #121b17;
    --surface: #171e1a;
    --surface-soft: #1c2721;
    --ink: #f5faf7;
    --ink-soft: #d4e3da;
    --ink-muted: #b9cec1;
    --accent: #8de4bb;
    --accent-hover: #b1f3d2;
    --accent-ink: #092118;
    --accent-soft: #244838;
    --on-accent-soft: #eefbf4;
    --focus: #ffb27b;
    --line: #82968a;
    --line-soft: #3e5147;
    --scene: #081b15;
    --scene-ink: #ffffff;
    --scene-muted: #d9eee6;
    --scene-accent: #ffdc7f;
    --glow: #294f3f;
    --background-color: var(--bg);
    --foreground-color: var(--ink);
    --focus-ring-color: var(--focus);
    color-scheme: dark;
  }
}

:root {
  --step--1: clamp(0.82rem, 0.79rem + 0.15vw, 0.92rem);
  --step-0: clamp(1rem, 0.96rem + 0.22vw, 1.14rem);
  --step-1: clamp(1.24rem, 1.12rem + 0.58vw, 1.62rem);
  --step-2: clamp(1.62rem, 1.35rem + 1.3vw, 2.5rem);
  --step-3: clamp(2.15rem, 1.65rem + 2.5vw, 3.85rem);
  --step-4: clamp(2.8rem, 1.85rem + 4.8vw, 6rem);
  --space: clamp(1rem, 0.72rem + 1.4vw, 2rem);
  --section: clamp(4rem, 2.7rem + 6vw, 8rem);
  --radius: 1rem;
  --radius-lg: 1.8rem;
  --measure: 67ch;
  --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-serif: Iowan Old Style, Baskerville, "Times New Roman", serif;
}
}

@layer theme.rebuild {
  .style-steward {
    --st-paper: #f3f2eb;
    --st-surface: #e5e8e1;
    --st-card: #edf0eb;
    --st-ink: #101813;
    --st-muted: #34463e;
    --st-rule: #707d76;
    --st-brand: #073e34;
    --st-brand-deep: #062c26;
    --st-brand-text: #073e34;
    --st-on-brand: #ffffff;
    --st-link: #064f77;
    --st-link-hover: #043b59;
    --st-focus: #944000;
    --paper: var(--st-paper);
    --forest: var(--st-brand);
    --forest-2: var(--st-brand-deep);
    --bg: var(--st-paper);
    --surface: var(--st-card);
    --surface-soft: var(--st-surface);
    --ink: var(--st-ink);
    --ink-soft: var(--st-muted);
    --ink-muted: var(--st-muted);
    --muted: var(--st-muted);
    --line: var(--st-rule);
    --line-soft: var(--st-rule);
    --accent: var(--st-link);
    --accent-hover: var(--st-link-hover);
    --accent-ink: #ffffff;
    --focus: var(--st-focus);
    --focus-ring-color: var(--st-focus);
    background: var(--st-paper);
    color: var(--st-ink);
  }

  :root[data-theme="dark"] .style-steward {
    --st-paper: #0b1210;
    --st-surface: #101c18;
    --st-card: #15231e;
    --st-ink: #f4f4ed;
    --st-muted: #c3d0c9;
    --st-rule: #71857a;
    --st-brand: #0e4a3c;
    --st-brand-deep: #06100d;
    --st-brand-text: #9de8c8;
    --st-on-brand: #ffffff;
    --st-link: #8bcdf2;
    --st-link-hover: #bce5fc;
    --st-focus: #ffb27b;
    --accent-ink: #07110d;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .style-steward {
      --st-paper: #0b1210;
      --st-surface: #101c18;
      --st-card: #15231e;
      --st-ink: #f4f4ed;
      --st-muted: #c3d0c9;
      --st-rule: #71857a;
      --st-brand: #0e4a3c;
      --st-brand-deep: #06100d;
      --st-brand-text: #9de8c8;
      --st-on-brand: #ffffff;
      --st-link: #8bcdf2;
      --st-link-hover: #bce5fc;
      --st-focus: #ffb27b;
      --accent-ink: #07110d;
    }
  }

  .style-steward .wrap { width: min(calc(100% - 3rem), 78rem); margin-inline: auto; }
  .style-steward .site-header { background: color-mix(in srgb, var(--st-paper) 96%, transparent); border-color: var(--st-rule); }
  .style-steward .site-header .brand,
  .style-steward .site-header .site-nav a,
  .style-steward .site-header .mode-toggle,
  .style-steward .site-header .nav-toggle { color: var(--st-ink); }
  .style-steward .site-header .site-nav .nav-cta { border-radius: 0; background: var(--st-brand); color: var(--st-on-brand); }
  .style-steward .site-header .site-nav .nav-cta:hover { background: var(--st-brand-deep); color: var(--st-on-brand); }
  .style-steward .search-slot { display: inline-flex; flex: 0 0 8.5166rem; min-width: 8.5166rem; min-height: 2.75rem; }
  .style-steward .brand-mark { background: var(--st-brand); color: var(--st-on-brand); }
  .style-steward .kicker { color: var(--st-link); font-size: .8rem; line-height: 1.35; }
  .style-steward .skip-link { background: var(--st-ink); color: var(--st-paper); }

  .steward-hero { padding: clamp(3.5rem, 7vw, 7rem) 0 5rem; }
  .hero-ledger { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(18rem, .65fr); gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .hero-statement h1 { max-width: 11ch; margin: .85rem 0 1.6rem; font-size: clamp(3.9rem, 7.7vw, 7.35rem); line-height: .87; }
  .hero-statement h1 em { color: var(--st-brand-text); }
  .hero-statement .hero-lead { max-width: 62ch; color: var(--st-muted); font-size: 1.08rem; line-height: 1.62; }
  .style-steward .actions { flex-wrap: wrap; gap: .75rem 1.25rem; }
  .style-steward .actions a { min-height: 3rem; padding-inline: .25rem; color: var(--st-ink); font-size: .8rem; }
  .style-steward .actions .solid { padding: .85rem 1.35rem; background: var(--st-ink); color: var(--st-paper); }
  .style-steward .actions .solid:hover { background: var(--st-brand); color: var(--st-on-brand); }
  .style-steward .text-action { gap: .5rem; }
  .style-steward .text-action::after { content: "↓"; }

  .routing-panel { align-self: stretch; padding: 1.5rem; background: var(--st-brand); color: var(--st-on-brand); }
  .routing-panel .kicker { color: #d5ecff; }
  .routing-panel h2 { max-width: 12ch; margin: .75rem 0 2rem; color: var(--st-on-brand); font-size: clamp(1.8rem, 3vw, 2.7rem); line-height: 1; }
  .routing-panel nav { display: grid; border-top: 1px solid #85a69d; }
  .routing-panel nav a { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 3.25rem; border-bottom: 1px solid #85a69d; background: var(--st-brand); color: var(--st-on-brand); font-size: .9rem; font-weight: 700; text-decoration: none; }
  .routing-panel nav a::after { content: "↘"; }
  .routing-panel nav a:hover { padding-inline: .4rem; background: rgb(255 255 255 / 10%); }

  .hero-proof { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: clamp(3rem, 6vw, 5rem); border-block: 1px solid var(--st-rule); }
  .hero-proof dl { display: flex; flex-direction: column-reverse; gap: .35rem; margin: 0; padding: 1.4rem 1.2rem; border-right: 1px solid var(--st-rule); }
  .hero-proof dl:nth-child(4) { border-right: 0; }
  .hero-proof dt { color: var(--st-muted); font-size: .8rem; text-transform: uppercase; }
  .hero-proof dd { margin: 0; font-size: clamp(1.8rem, 3vw, 2.8rem); letter-spacing: -.05em; }
  .hero-proof > p { grid-column: 1 / -1; max-width: none; padding: .85rem 1.2rem; border-top: 1px solid var(--st-rule); color: var(--st-muted); font-size: .78rem; }

  .office-frame { position: relative; overflow: hidden; margin-top: 2.5rem; }
  .office-frame img { display: block; width: 100%; height: auto; filter: saturate(.72) contrast(1.02); }
  .office-frame figcaption,
  .method-photo figcaption,
  .adviser-portrait figcaption { position: absolute; inset: auto auto 0 0; margin: 0; padding: .8rem 1rem; background: var(--st-brand); color: var(--st-on-brand); font-size: .78rem; font-style: normal; font-weight: 700; text-transform: uppercase; }

  .audiences { padding: clamp(5rem, 9vw, 9rem) 0; border-top: 1px solid var(--st-rule); }
  .split-title { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(16rem, .45fr); gap: clamp(2rem, 6vw, 6rem); align-items: end; margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .split-title h2 { line-height: .96; }
  .split-title > p { color: var(--st-muted); font-size: .82rem; line-height: 1.55; }
  .audience-grid { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--st-rule); }
  .audience-grid article { display: flex; min-height: 25rem; flex-direction: column; gap: 1rem; padding: clamp(1.5rem, 3vw, 2.5rem); border-right: 1px solid var(--st-rule); }
  .audience-grid article:last-child { border-right: 0; }
  .audience-grid article > span,
  .domain-grid article > span { color: var(--st-link); font-size: .8rem; font-weight: 800; text-transform: uppercase; }
  .audience-grid h3 { margin-top: auto; font-size: clamp(1.8rem, 2.7vw, 2.6rem); line-height: 1; }
  .audience-grid p { color: var(--st-muted); font-size: 1rem; }
  .audience-grid a { display: inline-flex; align-items: center; width: fit-content; min-height: 2.75rem; color: var(--st-ink); font-size: .82rem; font-weight: 800; }
  .audience-grid a::after { content: "→"; margin-left: .45rem; }

  .doctrine { padding: clamp(4.5rem, 8vw, 7rem) 0; border-block: 1px solid var(--st-rule); }
  .doctrine-grid { display: grid; grid-template-columns: minmax(8rem, .55fr) minmax(12rem, .8fr) minmax(0, 1.65fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; border-color: var(--st-rule); }
  .doctrine h2 { font-size: 1.5rem; line-height: 1.15; }
  .doctrine blockquote { margin: 0; color: var(--st-ink); font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1.1; }

  .disciplines, .method, .domains { padding: clamp(5rem, 9vw, 9rem) 0; border-bottom: 1px solid var(--st-rule); }
  .service-list { border-color: var(--st-rule); }
  .service-list li { display: block; padding: 0; border-color: var(--st-rule); }
  .service-row { display: grid; grid-template-columns: 3.25rem 1fr 1.2fr auto; gap: 2rem; align-items: center; min-height: 7rem; padding: 1.3rem 1rem; color: var(--st-ink); text-decoration: none; transition: background-color 180ms ease, padding-inline 180ms ease; }
  .service-row:hover { padding-inline: 1.25rem .75rem; background: var(--st-card); color: var(--st-ink); }
  .service-row .service-index { background: transparent; color: var(--st-link); font-size: .8rem; font-weight: 800; }
  .service-row h3 { font-size: 1.35rem; }
  .service-row p { color: var(--st-muted); font-size: 1rem; line-height: 1.55; }
  .service-action { display: inline-flex; align-items: center; justify-content: flex-end; gap: .6rem; min-height: 2.75rem; background: transparent; color: var(--st-ink); font-size: .78rem; font-weight: 800; text-align: right; text-transform: uppercase; }
  .service-action::after { content: "→"; font-size: 1rem; transition: transform 180ms ease; }
  .service-row:hover .service-action::after { transform: translateX(.25rem); }

  .capital-record { padding: clamp(5rem, 9vw, 8rem) 0; background: var(--st-brand); color: var(--st-on-brand); }
  .capital-record h2 { max-width: 18ch; color: var(--st-on-brand); }
  .capital-record .kicker { color: #d5ecff; }
  .record-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: clamp(2.5rem, 5vw, 4rem); border: 1px solid #85a69d; }
  .record-grid dl { min-width: 0; margin: 0; padding: clamp(1.3rem, 3vw, 2rem); border-right: 1px solid #85a69d; }
  .record-grid dl:last-child { border-right: 0; }
  .record-grid dd { display: grid; gap: .4rem; }
  .record-grid dt, .record-grid small { color: #e3eee9; }
  .record-grid small { font-size: .75rem; line-height: 1.4; }
  .record-note { max-width: none; padding: 1rem 0 1.2rem; border-top: 1px solid #85a69d; color: #e3eee9; font-size: .78rem; }

  .method-grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(22rem, 1.15fr); gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .method h2 { margin: .8rem 0 2rem; }
  .method ol { margin: 0; padding: 0; list-style: none; }
  .method li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: .6rem; padding: 1.35rem 0; border-bottom: 1px solid var(--st-rule); }
  .method li b { color: var(--st-link); font-size: .8rem; }
  .method li span { display: grid; gap: .35rem; color: var(--st-muted); font-size: .95rem; line-height: 1.55; }
  .method li strong { color: var(--st-ink); font-size: 1rem; }
  .method-photo { position: relative; overflow: hidden; min-width: 0; }
  .method-photo img { width: 100%; min-height: 36rem; aspect-ratio: 4 / 5; object-fit: cover; }
  .method-photo figcaption { inset: auto 0 0; }

  .domain-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--st-rule); border: 1px solid var(--st-rule); }
  .domain-grid article { display: flex; min-height: 20rem; flex-direction: column; gap: 1rem; padding: clamp(1.4rem, 2.5vw, 2rem); border-color: var(--st-rule); background: var(--st-card); }
  .domain-grid h3, .domain-grid p, .domain-grid span { background: transparent; }
  .domain-grid h3 { margin-top: auto; font-size: 1.65rem; }
  .domain-grid p { color: var(--st-muted); font-size: .95rem; line-height: 1.55; }

  .people { padding: clamp(5rem, 9vw, 9rem) 0; border-top: 1px solid var(--st-rule); background: var(--st-surface); }
  .people-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(20rem, .95fr); gap: clamp(3rem, 8vw, 8rem); align-items: center; }
  .adviser-portrait { position: relative; min-width: 0; }
  .adviser-portrait img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 42% center; filter: saturate(.68); }
  .adviser-portrait figcaption { inset: auto 0 0; text-transform: none; }
  .people-copy h2 { max-width: 12ch; margin: .8rem 0 1.5rem; font-size: clamp(2.8rem, 5vw, 5rem); overflow-wrap: anywhere; text-transform: uppercase; }
  .people-copy > p:not(.kicker):not(.demo-note) { color: var(--st-muted); font-size: 1.05rem; }
  .profile { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--st-rule); }
  .profile h3 { font-size: 1.7rem; }
  .profile > p { margin-top: .3rem; color: var(--st-muted); font-size: .9rem; }
  .profile ul { display: grid; gap: .55rem; margin: 1.25rem 0 0; padding-left: 1.2rem; color: var(--st-muted); font-size: .92rem; }
  .people-copy .demo-note { margin-top: 1.5rem; color: var(--st-muted); font-size: .78rem; }

  .endorsement { padding: clamp(5rem, 9vw, 8rem) 0; background: var(--st-paper); }
  .endorsement blockquote { max-width: 22ch; margin: 1.25rem 0; color: var(--st-ink); font-size: clamp(2.3rem, 5vw, 4.8rem); line-height: 1.02; }
  .endorsement > div > p:last-child { color: var(--st-muted); font-size: .8rem; }

  .steward-close { padding: clamp(4.5rem, 8vw, 7rem) 0; background: var(--st-brand); color: var(--st-on-brand); }
  .steward-close .wrap { display: flex; justify-content: space-between; align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .steward-close h2 { max-width: 16ch; color: var(--st-on-brand); line-height: .95; overflow-wrap: anywhere; }
  .steward-close .kicker { color: #d5ecff; }
  .steward-close .wrap > div > p:last-child { max-width: 58ch; margin-top: 1rem; color: #e3eee9; }
  .paper-button { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; min-height: 3rem; padding: .9rem 1.25rem; background: var(--st-on-brand); color: #073e34; }
  .paper-button:hover { background: #e3eee9; color: #062c26; }

  .style-steward .site-footer { background: var(--st-brand-deep); color: var(--st-on-brand); }
  .style-steward .site-footer a,
  .style-steward .site-footer p,
  .style-steward .site-footer h2 { color: var(--st-on-brand); }

  @media (max-width: 64rem) {
    .style-steward .site-nav { background: var(--st-paper); }
    .style-steward .search-slot { flex: 0 0 auto; width: 2.75rem; min-width: 2.75rem; }
  }

  @media (max-width: 50rem) {
    .hero-ledger, .doctrine-grid, .split-title, .method-grid, .people-grid { grid-template-columns: 1fr; }
    .hero-ledger { gap: 3rem; }
    .routing-panel { min-height: 0; }
    .hero-proof { grid-template-columns: repeat(2, 1fr); }
    .hero-proof dl:nth-child(2) { border-right: 0; }
    .hero-proof dl:nth-child(-n + 2) { border-bottom: 1px solid var(--st-rule); }
    .audience-grid { grid-template-columns: 1fr; }
    .audience-grid article { min-height: 0; border-right: 0; border-bottom: 1px solid var(--st-rule); }
    .audience-grid article:last-child { border-bottom: 0; }
    .audience-grid h3 { margin-top: 2rem; }
    .service-row { grid-template-columns: 2.25rem 1fr; gap: .6rem 1rem; min-height: 0; padding-block: 1.5rem; }
    .service-row h3 { grid-column: 2; }
    .service-row p, .service-action { grid-column: 2; }
    .service-action { justify-content: flex-start; text-align: left; }
    .method-photo img, .adviser-portrait img { min-height: 0; aspect-ratio: 4 / 3; }
    .people-copy h2 { font-size: clamp(2.2rem, 10.5vw, 3.4rem); }
    .steward-close .wrap { align-items: flex-start; }
  }

  @media (max-width: 36rem) {
    .style-steward .wrap { width: min(calc(100% - 2rem), 78rem); }
    .hero-statement h1 { font-size: clamp(2.65rem, 13.2vw, 4.5rem); }
    .style-steward .actions { align-items: flex-start; flex-direction: column; }
    .hero-proof { grid-template-columns: 1fr; }
    .hero-proof dl { border-right: 0; border-bottom: 1px solid var(--st-rule); }
    .hero-proof dl:nth-child(4) { border-bottom: 0; }
    .record-grid, .domain-grid { grid-template-columns: 1fr; }
    .record-grid dl { border-right: 0; border-bottom: 1px solid #85a69d; }
    .record-grid dl:last-child { border-bottom: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-row, .service-action::after, .routing-panel nav a { transition: none; }
    .service-row:hover .service-action::after { transform: none; }
  }
}

@layer theme.base {
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body { margin: 0; overflow-x: clip; background: var(--bg); color: var(--ink); font-family: var(--font-sans); font-size: var(--step-0); line-height: 1.62; }
h1, h2, h3, p, ul, dl, dd, figure, blockquote { margin: 0; }
